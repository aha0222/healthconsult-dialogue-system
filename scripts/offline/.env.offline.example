# 离线档配置（成员 B）
#
# 用法：复制成 .env.offline 后按需修改。
#   copy scripts\offline\.env.offline.example scripts\offline\.env.offline
#
# scripts/offline/start.ps1 会读这个文件；其中 OFFLINE_LLM_ENDPOINT 会被
# 脚本自动挑的端口**覆盖**（端口 8080 常被别的服务占用）。
#
# 与在线档的区别：这份不依赖任何云端服务，删掉 DEEPSEEK_API_KEY 也能跑。

# ── 离线开关（本档的核心）─────────────────────────────────────────────
OFFLINE_MODE=1
OFFLINE_LLM_BACKEND=auto
OFFLINE_LLM_ENDPOINT=http://127.0.0.1:8080

# 进程内后端（llama-cpp-python）才用；用端点后端时留空即可
OFFLINE_LLM_MODEL_PATH=

# auto 模式下：端点连不上就回退进程内后端，并打 WARNING 记录原因。
# 设 1 则锁定后端、禁用回退——配置写错时直接失败，不掩盖问题。
OFFLINE_LLM_STRICT=0

# CPU 推理慢，超时给足；探活要短，否则端点挂掉时每请求白等
OFFLINE_LLM_TIMEOUT=180
OFFLINE_LLM_PROBE_TIMEOUT=3

# 解析结果缓存秒数。main.py 的 get_memory() 每请求都构造 MemoryManager，
# 不缓存就会每请求探活一次。
OFFLINE_LLM_RESOLVE_TTL=30

# ── 嵌入 ──────────────────────────────────────────────────────────────
# hash = 纯 Python 字符 n-gram，零依赖零下载，离线可用（推荐）
# 要用本地权重就改成 local，并先装 sentence-transformers + 备好权重
EMBEDDING_BACKEND=hash
# 严格模式：缺依赖时抛错而非静默回退 hash。1 = 严格（默认）
EMBEDDING_STRICT=1

# ── 占位 Key ──────────────────────────────────────────────────────────
# /api/chat/stream 有一道 `if not settings.has_api_key: 502` 的门禁，
# 离线时没有云端 key 会被拦在第一句。这个哑值只为过门禁，LocalLLM 不读它。
# 正解见交付报告第 5 节的接线 diff（给门禁加 offline_mode 豁免）。
DEEPSEEK_API_KEY=sk-local

# ── 其余按离线场景收紧 ────────────────────────────────────────────────
# 3B 模型在 CPU 上生成慢，把每轮压到可接受范围
MAX_TOKENS=400
MAX_HISTORY=6
MAX_MESSAGE_CHARS=1000

# 含 null 是为了让 file:// 直接打开 frontend/chat.html 时也能访问后端
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,null

# 留空：否则每轮问答会白等 3 秒 webhook 超时
ALERT_WEBHOOK_URL=

# 三层安全。SEMANTIC_CHECK=1 表示高风险（R3/R2b）会**再调一次本地模型**复核。
# 关掉能省一半推理时间，但等于主动减去一层安全——要关必须在交付材料里写明。
SEMANTIC_CHECK=1
# 离线档放宽到全等级（B 交付报告 7.7 节短期方案）：本地小模型不输出标签，
# 关键词兜底对高风险口语表述漏检率约 49%，若只对 R3/R2b 复核，
# 被误判成 R0/R1 的高风险输入会整层跳过语义复核。代价是每轮多一次本地推理。
SEMANTIC_CHECK_RISKS=R3,R2b,R2a,R1,R0

# 语音服务默认关。A 的空壳 /asr 与 /tts 返回 501，开着只会拖慢冷启动。
# 想用「按住说话 + 语音播报」就改成 1（start.ps1 会顺带拉起 voice_service）。
VOICE_ENABLED=0

# 说话人识别默认关。改成 1 后按称呼/照护动词区分「老人本人」与「家属」，
# 只影响称呼与内容侧重，不放松任何安全红线（平局/低置信一律按老人本人处理）。
SPEAKER_DETECT_ENABLED=0
