# 复制为 .env 并按需修改；.env 不会被提交（见 .gitignore）

# 大模型（必填）
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 后端访问密钥：留空则关闭鉴权（仅建议本地开发）；部署时务必设置
BACKEND_API_KEY=
# 多用户/多密钥：逗号分隔的额外密钥（任一匹配即通过），与 BACKEND_API_KEY 并存
BACKEND_API_KEYS=

# 运行环境：development / production；production 下缺鉴权或 CORS 通配会拒绝启动
ENVIRONMENT=development

# 每 IP 每分钟请求上限；0 表示关闭
RATE_LIMIT_PER_MINUTE=60

# 只信任这些代理（IP 或 CIDR，逗号分隔）的 X-Forwarded-For；留空则一律用直连 IP
TRUSTED_PROXIES=

# 允许的前端来源，逗号分隔，请显式列出（file:// 打开的页面 Origin 为 null）
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,null

# 历史消息条数上限
MAX_HISTORY=10

# SQLite 路径（默认 backend/data/sessions.db）
# DB_PATH=

# 非标准部署（Docker / zip / pip 安装）时覆盖 skill 定位；一般无需设置
# XIAONUAN_REPO_ROOT=
# XIAONUAN_SKILL_DIR=

# 日志
LOG_LEVEL=INFO
LOG_FORMAT=plain

# 高风险语义复核（第三层安全在线版）：默认开启，仅对指定风险等级额外调一次 LLM；设为 0 可关闭
SEMANTIC_CHECK=1
SEMANTIC_CHECK_RISKS=R3,R2b
SEMANTIC_CHECK_FALLBACK=1

# 高危告警：命中 fallback 或风险等级在列表中时记录告警；配置 webhook 则额外推送
ALERT_RISKS=R3,R2b
ALERT_WEBHOOK_URL=
# webhook 是否脱敏：1（默认）只推结构化字段+原文长度/哈希，0 则推送完整原文
ALERT_WEBHOOK_REDACT=1

# 长会话记忆：超过阈值时把较旧对话压缩成摘要与画像并注入 prompt
SUMMARY_ENABLED=1
SUMMARY_THRESHOLD=20
SUMMARY_KEEP_RECENT=10

# 性能与成本
MAX_MESSAGE_CHARS=2000
MAX_PROFILE_CHARS=1000
MAX_HISTORY_ITEMS=20
MAX_TOKENS=600
TEMPERATURE=0.7
# DeepSeek 默认开启思考模式（响应慢且忽略 temperature）；实时对话建议关闭，需要更强推理时设为 1
THINKING_ENABLED=0
# 模型路由：高风险走 MODEL_STRONG，其余走 MODEL_FAST（留空则用 DEEPSEEK_MODEL）
ROUTING_ENABLED=0
MODEL_FAST=
MODEL_STRONG=
# 回复缓存：仅缓存低风险、无上下文的首轮问答
CACHE_ENABLED=0
CACHE_TTL_SECONDS=300
CACHE_MAX_SIZE=256

# 运行时分级与检索（第 6 条：识别场景/风险 + Retriever/Reranker）
# 运行时用关键词快路径预判 risk/scenes（0 token）；歧义交给主 LLM
RUNTIME_CLASSIFIER=1
# 非高风险时检索相似语料，Reranker 取 Top-N 注入生成 prompt
RUNTIME_RETRIEVAL=1
# 典型低风险（R0/R1）用精简 prompt（保留规范小节，去掉静态示例）以省 token
PROMPT_COMPACT=1
# 检索语料（带回复）与嵌入后端；hash 零下载可移植，local 用神经网络模型（需 sentence-transformers）
EXEMPLAR_CORPUS_PATH=
EXEMPLAR_EMBEDDING_BACKEND=hash
RETRIEVER_TOP_K=10
RERANKER_TOP_N=3
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ── 第三周新增能力开关（默认全部为 0＝保持现有行为）────────────────
# 语音能力：独立服务 voice_service（前端直连 http://127.0.0.1:8100）
# 关闭时系统为打字版；语音服务未启动/未实现时也应保持关闭
VOICE_ENABLED=0
# 离线/私有化：1 时 providers.get_llm() 改用本地或私有端点 LLM；0 时走上面的云端配置
OFFLINE_MODE=0
# 说话人角色识别：1 时区分"老人本人/家属"并调整称呼与内容侧重；0 时恒按老人处理
SPEAKER_DETECT_ENABLED=0
